# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter fallback (optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free

# ── MCP Server ────────────────────────────────────────────────────────────────
# Absolute path to server.py in your cloned repo
MCP_SERVER_PATH=/path/to/protocol_combined/server.py
MCP_PYTHON_BIN=python3

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=oncology_platform

# ── Qdrant (RAG — optional for Phase 1) ──────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oncology_docs

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET=change_me_in_production
CORS_ORIGINS=http://localhost:3000
MAX_TOOL_ITERATIONS=10
STREAM_CHUNK_DELAY=0.02
